<Project>
  <PropertyGroup>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn> <!-- prevents XML doc warnings -->
  </PropertyGroup>

  <ItemGroup>
    <EditorConfigConfigurationFiles Include=".editorconfig" />
  </ItemGroup>
</Project>
